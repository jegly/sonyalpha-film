<?xml version="1.0" encoding="utf-8"?>
<com.filmsim.app.FullRedrawLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/filmBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#88000000"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFF2C46B"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/exposureBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#88000000"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/pickerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/exposureBar"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone" >

        <TextView
            android:id="@+id/picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:singleLine="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:typeface="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/filmBar"
        android:layout_marginTop="12dp"
        android:background="#CC000000"
        android:padding="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#88000000"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/keyInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/exposureBar"
        android:layout_alignParentRight="true"
        android:background="#CC000000"
        android:padding="4dp"
        android:textColor="#FF80C0FF"
        android:textSize="12sp"
        android:visibility="gone" />
</com.filmsim.app.FullRedrawLayout>
